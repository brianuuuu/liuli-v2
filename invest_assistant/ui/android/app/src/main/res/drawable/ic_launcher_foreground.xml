<?xml version="1.0" encoding="utf-8"?>
<!-- 前景层自带底色：桌面会叠背景层再套遮罩，看不出区别；但部分文件管理器显示未安装的 APK 时
     只画前景层，没有这层底色就只剩一个撑满的蓝色六边形，和桌面图标对不上。
     内缩决定六边形在桌面图标里占多大：20% 时标记占画布 60%，在圆形遮罩里显得压边，
     25% 后占 50%，四周留出呼吸。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/launcher_background" />
    </item>
    <item>
        <inset
            android:drawable="@drawable/ic_liuli_logo"
            android:inset="25%" />
    </item>
</layer-list>
